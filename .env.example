# Turso 数据库连接配置
# 复制本文件为 .env 并填入真实值（.env 不会被提交到仓库）
# Nuxt 约定：NUXT_ 前缀 + 大写路径（点换成下划线）会覆盖 runtimeConfig.turso.databaseUrl / authToken

# 数据库 URL，格式形如 libsql://<db-name>.turso.io
NUXT_TURSO_DATABASE_URL=libsql://your-db-name.turso.io

# 数据库访问令牌，从 Turso 控制台或 `turso db tokens create` 获取
NUXT_TURSO_AUTH_TOKEN=eyJhbGciOi...
